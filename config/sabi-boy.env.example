# Sabi Boy V2 runtime
# Copy to ~/.config/sabi-boy/sabi-boy.env and keep that real file out of Git.

SABIAI_REPO_ROOT=/home/hendrix/.openclaw/workspace-prediction
SABIAI_DATA_DIR=/home/hendrix/.openclaw/workspace-prediction/data
SABIAI_LEGACY_DB=/home/hendrix/.openclaw/workspace/data/bets.db
SABIAI_V2_DB=/home/hendrix/.openclaw/workspace-prediction/data/sabiai_v2_core.db
SABIAI_TIMEZONE=Africa/Lagos
SABIAI_DASHBOARD_HOST=127.0.0.1
SABIAI_DASHBOARD_PORT=8091
SABIAI_DASHBOARD_ALLOWED_HOSTS=127.0.0.1,localhost,picks.hendrix.com.ng,testserver
SABIAI_DASHBOARD_ALLOWED_ORIGINS=https://picks.hendrix.com.ng,http://127.0.0.1:8090,http://127.0.0.1:8091,http://localhost:8090,http://localhost:8091,http://testserver

# Web Push. The preparation script creates the private key outside the repository
# and fills these values in the private runtime environment file.
SABIAI_VAPID_PRIVATE_KEY_FILE=/home/hendrix/.config/sabi-boy/vapid-private.pem
SABIAI_VAPID_PUBLIC_KEY=
SABIAI_VAPID_SUBJECT=https://picks.hendrix.com.ng

# Prediction is the existing OpenClaw integration identity. Its human-facing
# product/persona is Sabi Boy.
SABIAI_OPENCLAW_AGENT_ID=prediction

# Free/public source configuration.
# TheSportsDB documents public v1 key 123 for free access.
SABIAI_THESPORTSDB_KEY=123

# Optional free-tier football-data.org token. Leave unset to skip this adapter.
# SABIAI_FOOTBALL_DATA_TOKEN=

# Parse APIs. Keep the API key only in this private file. Scraper IDs are the
# non-secret IDs of the subscribed read-only APIs. Do not add 1xBet or Stake.
# SABIAI_PARSE_API_KEY=
# SABIAI_PARSE_FLASHSCORE_SCRAPER_ID=
# SABIAI_PARSE_LIVESCORE_SCRAPER_ID=
# SABIAI_PARSE_SPORTYBET_SCRAPER_ID=
# SABIAI_PARSE_ESPN_SCRAPER_ID=

# Optional read-only suggested-picks source. Its output must be independently verified.
# SABIAI_SPORTS_BETTING_ANALYZER_API_KEY=

# Paid sources are a last resort. 0 disables paid escalation entirely.
SABIAI_PAID_SOURCES=0
