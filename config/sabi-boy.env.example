# Sabi Boy V2.4 runtime
# Copy to ~/.config/sabi-boy/sabi-boy.env and keep that real file out of Git.

SABIAI_REPO_ROOT=/home/hendrix/.openclaw/workspace-prediction
SABIAI_DATA_DIR=/home/hendrix/.openclaw/workspace-prediction/data
SABIAI_LEGACY_DB=/home/hendrix/.openclaw/workspace/data/bets.db
SABIAI_V2_DB=/home/hendrix/.openclaw/workspace-prediction/data/sabiai_v2_core.db
SABIAI_TIMEZONE=Africa/Lagos
SABIAI_DASHBOARD_HOST=127.0.0.1
SABIAI_DASHBOARD_PORT=8091
SABIAI_DASHBOARD_ALLOWED_HOSTS=127.0.0.1,localhost,picks.hendrix.com.ng,testserver
SABIAI_DASHBOARD_ALLOWED_ORIGINS=https://picks.hendrix.com.ng,http://127.0.0.1:8090,http://127.0.0.1:8091,http://localhost:8090,http://localhost:8091,http://testserver

# Web Push. The preparation script creates the private key outside the repository.
SABIAI_VAPID_PRIVATE_KEY_FILE=/home/hendrix/.config/sabi-boy/vapid-private.pem
SABIAI_VAPID_PUBLIC_KEY=
SABIAI_VAPID_SUBJECT=https://picks.hendrix.com.ng

# Prediction is the existing OpenClaw integration identity. Its human-facing persona is Sabi Boy.
SABIAI_OPENCLAW_AGENT_ID=prediction
SABIAI_OPENCLAW_DELIVERY_CHANNEL=matrix
SABIAI_OPENCLAW_DELIVERY_TO=!lkXVdwqsWDeBqhharF:chat.hendrix.com.ng
SABIAI_OPENCLAW_DELIVERY_ACCOUNT=sabiai

# Bounded AI research. Discovery/market inventory is a separate no-model process.
SABIAI_RESEARCH_API_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
SABIAI_RESEARCH_MODEL=qwen3.8-max-preview
SABIAI_RESEARCH_SPORTS=football,basketball,volleyball,tennis,table_tennis,baseball,ice_hockey,cricket,golf,handball,rugby,darts,snooker,badminton,mma,boxing,motorsport,cycling,futsal,water_polo,beach_volleyball,padel,floorball,aussie_rules,esports,american_football,horse_racing,greyhound_racing,rugby_league,athletics,winter_sports
SABIAI_RESEARCH_MAX_EVENTS=120
SABIAI_RESEARCH_MAX_EVENTS_PER_SPORT=40
SABIAI_RESEARCH_SLICE_WORKERS=4
SABIAI_RESEARCH_SLICE_TTL_SECONDS=86400
SABIAI_RESEARCH_MAX_RECOMMENDATIONS=18
# SABIAI_RESEARCH_API_KEY=
# SABIAI_RESEARCH_FALLBACK_API_BASE_URL=
# SABIAI_RESEARCH_FALLBACK_API_KEY=
# SABIAI_RESEARCH_FALLBACK_MODEL=qwen3.6-flash
SABIAI_OPENCLAW_RESEARCH_MODEL=aliyun-token-plan/qwen3.8-max-preview
SABIAI_OPENCLAW_RESEARCH_FALLBACKS=opencode-go/qwen3.7-max

# -----------------------------------------------------------------------------
# V2.4 deterministic Discovery Radar
# -----------------------------------------------------------------------------
# Cheap discovery is intentionally much larger than model analysis. Standard sports use
# a rolling 72h horizon; golf/motorsport/cycling can use 7d; MMA/boxing can use 14d.
SABIAI_DISCOVERY_HORIZON_HOURS=72
SABIAI_DISCOVERY_LONG_HORIZON_HOURS=168
SABIAI_DISCOVERY_EVENT_HORIZON_HOURS=336
SABIAI_DISCOVERY_MAX_EVENTS=2000
SABIAI_DISCOVERY_MAX_SOURCE_REQUESTS=300
SABIAI_DISCOVERY_SOURCE_TTL_SECONDS=3600
SABIAI_DISCOVERY_REFRESH_MINUTES=30
SABIAI_PREFILTER_MAX_EVENTS=300
SABIAI_MARKET_INVENTORY_MAX_OFFERS=5000
SABIAI_MARKET_REFRESH_SECONDS=1800
SABIAI_MARKET_HISTORY_KEEP_DAYS=21

# Free/public source configuration.
SABIAI_THESPORTSDB_KEY=123
# SABIAI_FOOTBALL_DATA_TOKEN=

# Parse APIs use limited account credits. They remain useful for targeted action-book/detail
# work, but the frequent discovery radar does NOT union Parse sources unless explicitly enabled.
# SABIAI_PARSE_API_KEY=
# SABIAI_PARSE_FLASHSCORE_SCRAPER_ID=
# SABIAI_PARSE_LIVESCORE_SCRAPER_ID=
# SABIAI_PARSE_SPORTYBET_SCRAPER_ID=
# SABIAI_PARSE_ESPN_SCRAPER_ID=
SABIAI_DISCOVERY_PARSE_UNION=0

# Optional The Odds API sensor.
# /sports and /events are used for broad zero-quota discovery when a key is present.
# Odds/deep-market calls consume quota and remain OFF unless explicitly enabled below.
# SABIAI_THE_ODDS_API_KEY=
SABIAI_THE_ODDS_REGIONS=uk,eu
SABIAI_THE_ODDS_MAX_LEAGUES_PER_SPORT=30
SABIAI_COVERAGE_METERED_MARKETS=0
SABIAI_COVERAGE_METERED_SPORT_LIMIT=12
SABIAI_COVERAGE_DEEP_MARKETS=0
SABIAI_COVERAGE_DEEP_MARKET_EVENT_LIMIT=20
SABIAI_COVERAGE_DEEP_MARKET_KEY_LIMIT=12

# Optional Betfair Exchange read-only sensor. These credentials are used only for event/market
# catalogue and best-back price reads. Sabi Boy contains no place/cancel/replace order method.
# SABIAI_BETFAIR_APP_KEY=
# SABIAI_BETFAIR_SESSION_TOKEN=
SABIAI_BETFAIR_MAX_MARKETS_PER_SPORT=500
SABIAI_BETFAIR_PRICES=1

# Optional read-only suggested-picks source. Independently verify its output.
# SABIAI_SPORTS_BETTING_ANALYZER_API_KEY=

# Generic paid escalation remains a last resort. V2.4 coverage-metered markets have their own
# stricter switch above and cannot be enabled merely by setting this value to 1.
SABIAI_PAID_SOURCES=0
