[Unit]
Description=Sabi Boy deterministic discovery and market coverage radar
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=4

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/sabi-boy/sabi-boy.env
WorkingDirectory=%h/.openclaw/workspace
ExecStart=%h/.openclaw/workspace/.venv/bin/python %h/.openclaw/workspace/scripts/sabi_v2_discovery_radar.py
Restart=on-failure
RestartSec=3min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
