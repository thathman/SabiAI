[Unit]
Description=Sabi Boy local source and readiness health check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/sabi-boy/sabi-boy.env
WorkingDirectory=%h/.openclaw/workspace
ExecStart=%h/.openclaw/workspace/.venv/bin/python %h/.openclaw/workspace/scripts/sabi_v2_health_heartbeat.py
NoNewPrivileges=true
PrivateTmp=true
