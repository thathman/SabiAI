[Unit]
Description=Sabi Boy automatic result heartbeat and settlement
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/sabi-boy/sabi-boy.env
WorkingDirectory=%h/.openclaw/workspace
ExecStart=%h/.openclaw/workspace/.venv/bin/python %h/.openclaw/workspace/scripts/sabi_v2_settlement_heartbeat.py
NoNewPrivileges=true
PrivateTmp=true
